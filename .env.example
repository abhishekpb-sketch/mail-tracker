# Environment Variables for Mail Tracker Backend
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub — it contains secrets!

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/mailtracker?retryWrites=true&w=majority

# A secret key — make it long and random (e.g., use https://randomkeygen.com)
# This key is used by the dashboard and extension to authenticate API calls
API_KEY=your-super-secret-api-key-here

# The public URL of your deployed backend (set this after deploying to Render)
BASE_URL=https://your-app-name.onrender.com

# Port (Render sets this automatically, leave as is)
PORT=3000
